# ==============================================================================
# GeM TenderLens - Environment Configuration Example (.env.example)
# Copy this file to '.env' and populate with your actual service credentials.
# Command: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Primary & Fallback LLM Provider Settings
# Supported values for LLM_PROVIDER: mistral, groq, gemini
# ------------------------------------------------------------------------------
LLM_PROVIDER=mistral
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=mistral-small-latest

# Mistral AI API Config (LLM Answer Synthesis & CrewAI Agents)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Groq API Config
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Config
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API Config (Web Research Tools)
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# Cohere API Configuration (Vector Embeddings)
# ------------------------------------------------------------------------------
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=embed-english-v3.0

# ------------------------------------------------------------------------------
# ChromaDB Vector Store Persistence Path
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# ------------------------------------------------------------------------------
# Relational Database Connection URL (SQLAlchemy ORM)
# Default for local development: SQLite database file
# Example for PostgreSQL: postgresql://user:password@localhost:5432/tenderlens_db
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./tenderlens.db

# ------------------------------------------------------------------------------
# Observability & Tracing (LangSmith & LangChain - Optional)
# ------------------------------------------------------------------------------
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_TRACING_V2=true
LANGSMITH_PROJECT=gem-tenderlens
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=gem-tenderlens
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
